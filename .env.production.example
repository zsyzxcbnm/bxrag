# Production configuration template.
# Do not commit a real .env file or real credentials.
# Inject secrets through your deployment platform or secret manager.

POSTGRES_DSN=postgresql://apex_app:REPLACE_WITH_SECRET@db.internal:5432/apex?sslmode=require
BACKEND=postgres

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=/opt/apex/models/bge-large-en-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cuda
EMBEDDING_QUERY_PROMPT=

RERANKER_PROVIDER=heuristic
RERANKER_MODEL=/opt/apex/models/bge-reranker-large
RERANKER_DEVICE=cuda
RERANKER_FP16=true

DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
RERANK_CANDIDATES=20
FINAL_K=5
RRF_K=60

HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=80

DATA_DIR=/opt/apex/data
REPORTS_DIR=/opt/apex/reports
ARTIFACTS_DIR=/opt/apex/data/artifacts

OPENAI_API_KEY=

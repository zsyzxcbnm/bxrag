# PostgreSQL (matches docker-compose.yml)
POSTGRES_DSN=postgresql://apex:apex@localhost:5432/apex
BACKEND=postgres

# local = offline TF-IDF + SVD fallback (no API key required)
# openai = text-embedding-3-small (requires OPENAI_API_KEY)
# sentence-transformers = local Qwen3/BGE embedding model
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-tfidf-svd
EMBEDDING_DIM=128
OPENAI_API_KEY=
EMBEDDING_DEVICE=
EMBEDDING_QUERY_PROMPT=

# heuristic = dependency-free local reranker
# cross-encoder = sentence-transformers CrossEncoder (optional dependency)
RERANKER_PROVIDER=heuristic
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

DENSE_LIMIT=50
SPARSE_LIMIT=50
RERANK_CANDIDATES=20
FINAL_K=5
RRF_K=60
DENSE_WEIGHT=0.4
SPARSE_WEIGHT=0.6

HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=80

DATA_DIR=data
REPORTS_DIR=reports
ARTIFACTS_DIR=data/artifacts

